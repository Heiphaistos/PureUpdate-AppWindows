<Page
    x:Class="PureUpdate.UI.Views.DriversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent">

    <Grid Margin="28,22,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#C8E0F8">
                    <Run Text="Pilotes"/>
                </TextBlock>
                <TextBlock Text="Détection des pilotes défaillants ou manquants"
                           FontSize="11" Foreground="#2E4A60" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Primary" FontSize="12.5" Padding="16,9" Margin="0,0,8,0"
                           Command="{Binding ScanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE773;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Analyser" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button FontSize="12.5" Padding="16,9"
                           Command="{Binding OpenDeviceManagerCommand}"
                           ToolTip="Ouvrir le Gestionnaire de périphériques">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B8;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Gestionnaire" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ProgressBar IsIndeterminate="True" Width="48" Height="3" Margin="14,0,0,0"
                             Foreground="#00B7FF" VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#091525" Offset="0"/>
                    <GradientStop Color="#0C1A2E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#182E48" Offset="0"/>
                    <GradientStop Color="#0E1C2E" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border CornerRadius="8" Background="#050E1A" BorderBrush="#0E1C2E" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Foreground="#1E3A54"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#6090B0" FontSize="12"
                                 VerticalAlignment="Center" Padding="8,8"
                                 CaretBrush="#00B7FF">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Problems only toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Problèmes seulement"
                               FontSize="12" Foreground="#4A6A8A" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <ui:ToggleSwitch IsChecked="{Binding ShowProblemsOnly}"
                                     VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Problem count badge -->
                <Border Grid.Column="2" CornerRadius="8" Padding="12,4" Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding ProblemCount, Converter={StaticResource NonZeroToVis}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#2A0A0A" Offset="0"/>
                            <GradientStop Color="#1C0606" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Foreground="#FF6060"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF6060"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding ProblemCount, Mode=OneWay}"/>
                            <Run Text="problème(s)"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Status bar -->
        <TextBlock Grid.Row="1" Text="{Binding StatusText}"
                   FontSize="11" Foreground="#2E4A60"
                   VerticalAlignment="Bottom" Margin="0,0,0,18"
                   HorizontalAlignment="Left"/>

        <!-- Drivers list -->
        <Border Grid.Row="2" CornerRadius="12" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#050A12" Offset="0"/>
                    <GradientStop Color="#070E1A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0E1A2A" Offset="0"/>
                    <GradientStop Color="#0A1420" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column headers -->
                <Grid Grid.Row="0" Margin="16,12,16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Périphérique"
                               FontSize="10.5" FontWeight="SemiBold" Foreground="#2A4A6A"/>
                    <TextBlock Grid.Column="1" Text="Fabricant"
                               FontSize="10.5" FontWeight="SemiBold" Foreground="#2A4A6A"/>
                    <TextBlock Grid.Column="2" Text="Classe"
                               FontSize="10.5" FontWeight="SemiBold" Foreground="#2A4A6A"/>
                    <TextBlock Grid.Column="3" Text="Statut"
                               FontSize="10.5" FontWeight="SemiBold" Foreground="#2A4A6A"/>
                </Grid>

                <Rectangle Grid.Row="0" Height="1" Fill="#0A1828" VerticalAlignment="Bottom" Margin="10,0"/>

                <!-- List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredDrivers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6,1" Padding="10,7" CornerRadius="7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                    <Setter Property="Background" Value="#0D0505"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#07FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Device name + warning icon -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="#FF6060"
                                                       VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DeviceName}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#8CB4D4"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                                <Setter Property="Foreground" Value="#D08080"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DriverProvider}"
                                                   FontSize="11" Foreground="#3A5878"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DeviceClass}"
                                                   FontSize="11" Foreground="#2E4A68"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Status badge -->
                                        <Border Grid.Column="3" CornerRadius="5" Padding="8,3"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#0A2E14"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                            <Setter Property="Background" Value="#2A0A0A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="9.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF6060"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredDrivers.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE8B8;" FontFamily="Segoe MDL2 Assets"
                               FontSize="48" Foreground="#0E1E30"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Aucun pilote à afficher"
                               FontSize="14" Foreground="#1A2E48"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Cliquez sur Analyser pour détecter les pilotes"
                               FontSize="11" Foreground="#0E1C2E"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
