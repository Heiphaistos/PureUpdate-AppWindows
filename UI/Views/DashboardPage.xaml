<Page
    x:Class="PureUpdate.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PureUpdate.UI.ViewModels"
    Background="Transparent"
    Title="Tableau de bord">

    <Page.DataContext>
        <vm:DashboardViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <!-- Status bar -->
            <Border Background="#12FFFFFF"
                    CornerRadius="10"
                    Padding="16,10"
                    Margin="0,0,0,16">
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                 Fill="{Binding IsAdmin, Converter={StaticResource AdminBrush}}"/>
                        <TextBlock Text="Administrateur" FontSize="12" Foreground="#A0B4D0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                 Fill="{Binding IsNetworkAvailable, Converter={StaticResource NetworkBrush}}"/>
                        <TextBlock Text="Réseau" FontSize="12" Foreground="#A0B4D0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding GlobalStatus}"
                               FontSize="12" Foreground="#7090B0"
                               VerticalAlignment="Center"/>
                </WrapPanel>
            </Border>

            <!-- Global actions -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <ui:Button Content="Analyser tout"
                           Command="{Binding ScanAllCommand}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Margin="0,0,12,0"
                           FontSize="14"
                           Padding="16,10"/>
                <ui:Button Content="Tout installer"
                           Command="{Binding InstallAllCommand}"
                           Icon="{ui:SymbolIcon ArrowDownload24}"
                           FontSize="14"
                           Padding="16,10"/>
                <ProgressBar IsIndeterminate="True"
                             Width="120" Height="4"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsScanningAll, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- Provider cards grid -->
            <ItemsControl ItemsSource="{Binding Providers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProviderCardViewModel}">
                        <ui:Card Margin="0,0,12,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="#E0EEFF"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11" Foreground="#6080A0"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <!-- Available badge -->
                                    <Border Grid.Column="1"
                                            CornerRadius="4" Padding="6,2"
                                            Background="{Binding IsAvailable, Converter={StaticResource AdminBrush}}">
                                        <TextBlock FontSize="10" Foreground="White" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="NON INSTALLÉ"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                            <Setter Property="Text" Value="ACTIF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- Update count -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding UpdateCount, Converter={StaticResource UpdateCountConv}}"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{Binding IsAvailable, Converter={StaticResource NetworkBrush}}"
                                           Margin="0,0,0,4"/>

                                <!-- Status -->
                                <TextBlock Grid.Row="2"
                                           Text="{Binding StatusText}"
                                           FontSize="12" Foreground="#5070A0"
                                           Margin="0,0,0,12"/>

                                <!-- Progress -->
                                <ProgressBar Grid.Row="3"
                                             IsIndeterminate="True"
                                             Height="3"
                                             Margin="0,0,0,8"
                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>

                                <!-- Buttons -->
                                <StackPanel Grid.Row="4" Orientation="Horizontal">
                                    <ui:Button Content="Analyser"
                                               Command="{Binding ScanCommand}"
                                               Icon="{ui:SymbolIcon Search24}"
                                               IsEnabled="{Binding IsAvailable}"
                                               Margin="0,0,8,0"
                                               FontSize="12"
                                               Padding="12,6"/>
                                    <ui:Button Content="Installer"
                                               Command="{Binding InstallCommand}"
                                               Icon="{ui:SymbolIcon ArrowDownload24}"
                                               Appearance="Primary"
                                               FontSize="12"
                                               Padding="12,6"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- SDI offline section -->
            <ui:Card Margin="0,4,0,0"
                     Visibility="{Binding SdiAvailable, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Mode Hors-Ligne — Snappy Driver Installer"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#E0EEFF"/>
                        <TextBlock Text="{Binding SdiStatus}"
                                   FontSize="12" Foreground="#5070A0" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Content="Lancer SDI"
                               Command="{Binding RunSdiCommand}"
                               Icon="{ui:SymbolIcon HardDrive24}"
                               Padding="12,6"/>
                </Grid>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
