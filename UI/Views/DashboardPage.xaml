<Page
    x:Class="PureUpdate.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PureUpdate.UI.ViewModels"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  CanContentScroll="False">
        <StackPanel Margin="24,18,24,24">

            <!-- Status bar -->
            <Border Background="#0C1828" CornerRadius="10"
                    Padding="16,9" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Fill="{Binding IsAdmin, Converter={StaticResource AdminBrush}}"/>
                            <TextBlock Text="Admin" FontSize="11.5" Foreground="#5070A0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Fill="{Binding IsNetworkAvailable, Converter={StaticResource NetworkBrush}}"/>
                            <TextBlock Text="Réseau" FontSize="11.5" Foreground="#5070A0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding GlobalStatus}"
                                   FontSize="11.5" Foreground="#304060" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <!-- Global scan + install -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="Analyser tout"
                                   Command="{Binding ScanAllCommand}"
                                   Appearance="Primary"
                                   Margin="0,0,8,0" FontSize="12" Padding="14,7"/>
                        <ui:Button Content="Tout installer"
                                   Command="{Binding InstallAllCommand}"
                                   FontSize="12" Padding="14,7"/>
                        <ProgressBar IsIndeterminate="True" Width="80" Height="3"
                                     Margin="10,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsScanningAll, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Provider cards grid -->
            <ItemsControl ItemsSource="{Binding Providers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProviderCardViewModel}">
                        <Border Margin="0,0,10,10" CornerRadius="12"
                                Background="#0C1828"
                                BorderBrush="{Binding AccentBrush}" BorderThickness="0,0,0,2">
                            <Grid Margin="18,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header: name + badge -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="#D8EEFF"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="10.5" Foreground="#2E4A6A"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="5" Padding="7,3"
                                            Background="{Binding AccentBrush}" Opacity="0.85">
                                        <TextBlock FontSize="9.5" Foreground="White" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="NON INSTALLÉ"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                            <Setter Property="Text" Value="ACTIF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- Update count -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding UpdateCount, Converter={StaticResource UpdateCountConv}}"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="{Binding AccentBrush}"
                                           Margin="0,0,0,2"/>

                                <!-- Status + progress -->
                                <TextBlock Grid.Row="2" Text="{Binding StatusText}"
                                           FontSize="11.5" Foreground="#304A6A" Margin="0,0,0,4"/>
                                <ProgressBar Grid.Row="3" IsIndeterminate="True" Height="2"
                                             Margin="0,0,0,8"
                                             Foreground="{Binding AccentBrush}"
                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Grid.Row="4" Text="{Binding ProgressText}"
                                           FontSize="10" Foreground="#2E4060"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                                <!-- Buttons -->
                                <WrapPanel Grid.Row="5">
                                    <!-- If available: scan + install -->
                                    <ui:Button Content="Analyser"
                                               Command="{Binding ScanCommand}"
                                               IsEnabled="{Binding IsAvailable}"
                                               Margin="0,0,7,0" FontSize="11.5" Padding="12,6"/>
                                    <ui:Button Content="Installer tout"
                                               Command="{Binding InstallCommand}"
                                               Appearance="Primary"
                                               IsEnabled="{Binding IsAvailable}"
                                               Margin="0,0,7,0" FontSize="11.5" Padding="12,6"/>
                                    <!-- Self-manage buttons -->
                                    <ui:Button Content="Installer le gestionnaire"
                                               Command="{Binding InstallSelfCommand}"
                                               Appearance="Caution"
                                               FontSize="11" Padding="10,6" Margin="0,0,7,0"
                                               Visibility="{Binding CanInstallSelf, Converter={StaticResource BoolToVis}}"/>
                                    <ui:Button Content="Désinstaller"
                                               Command="{Binding UninstallSelfCommand}"
                                               FontSize="11" Padding="10,6"
                                               Visibility="{Binding CanUninstallSelf, Converter={StaticResource BoolToVis}}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- SDI Offline -->
            <Border Background="#0A1020" CornerRadius="12"
                    BorderBrush="#FF6B00" BorderThickness="0,0,0,2"
                    Padding="18,14" Margin="0,2,10,0"
                    Visibility="{Binding SdiAvailable, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Mode Hors-Ligne — Snappy Driver Installer"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#D8EEFF"/>
                        <TextBlock Text="{Binding SdiStatus}"
                                   FontSize="11" Foreground="#405060" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="Lancer SDI"
                               Command="{Binding RunSdiCommand}"
                               Padding="12,6" FontSize="12"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
