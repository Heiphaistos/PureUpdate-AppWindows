<Window
    x:Class="PureUpdate.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:PureUpdate.UI.Views"
    Title="PureUpdate — Gestionnaire de mises à jour"
    Width="1280"
    Height="820"
    MinWidth="960"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    Background="#0F1520">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="BorderBrush"    Value="Transparent"/>
            <Setter Property="Foreground"     Value="#A0B4D0"/>
            <Setter Property="FontSize"       Value="14"/>
            <Setter Property="Padding"        Value="12,10"/>
            <Setter Property="Margin"         Value="0,2"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22008FFF"/>
                                <Setter Property="Foreground" Value="#00B7FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="#D0E8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#1A1A2A"
                BorderBrush="#2A2A3F"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Row="0" Margin="16,32,16,24">
                    <TextBlock Text="Pure"
                               FontSize="22"
                               FontWeight="Light"
                               Foreground="#B0C8FF"/>
                    <TextBlock Text="Update"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#00B7FF"
                               Margin="0,-6,0,4"/>
                    <Rectangle Height="1" Fill="#2A2A3F" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="12,0">
                    <RadioButton x:Name="BtnDashboard"
                                 Content="  Tableau de bord"
                                 Style="{StaticResource NavButtonStyle}"
                                 IsChecked="True"
                                 Checked="NavButton_Checked"/>
                    <RadioButton x:Name="BtnLogs"
                                 Content="  Journaux"
                                 Style="{StaticResource NavButtonStyle}"
                                 Checked="NavButton_Checked"/>
                    <RadioButton x:Name="BtnSettings"
                                 Content="  Paramètres"
                                 Style="{StaticResource NavButtonStyle}"
                                 Checked="NavButton_Checked"/>
                </StackPanel>

                <!-- Version -->
                <TextBlock Grid.Row="2"
                           Text="v1.0.0"
                           FontSize="11"
                           Opacity="0.4"
                           Margin="16,0,16,16"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Content Frame -->
        <Frame x:Name="MainFrame"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Background="Transparent"/>
    </Grid>
</Window>
