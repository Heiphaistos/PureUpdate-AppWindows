<Window
    x:Class="PureUpdate.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="PureUpdate — Gestionnaire de mises à jour"
    Width="1340" Height="840"
    MinWidth="1000" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    Background="#090E1A">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="BorderBrush"                Value="Transparent"/>
            <Setter Property="Foreground"                 Value="#506A84"/>
            <Setter Property="FontSize"                   Value="13.5"/>
            <Setter Property="Padding"                    Value="14,12"/>
            <Setter Property="Margin"                     Value="0,1"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <!-- Main content area -->
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="0,9,9,0" Margin="4,0,0,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <!-- Active left indicator bar -->
                            <Border x:Name="ActiveBar" Width="3" HorizontalAlignment="Left"
                                    CornerRadius="0,2,2,0" Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd"        Property="Background" Value="#1400B7FF"/>
                                <Setter TargetName="ActiveBar" Property="Background" Value="{DynamicResource ElectricCyanBrush}"/>
                                <Setter Property="Foreground"  Value="{DynamicResource ElectricCyanBrush}"/>
                                <Setter Property="FontWeight"  Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0EFFFFFF"/>
                                <Setter Property="Foreground" Value="#B0CCEC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" BorderBrush="#131E30" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#080E1C" Offset="0"/>
                    <GradientStop Color="#0B1426" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo block -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="16,28,16,14">
                    <Image Source="pack://application:,,,/Resources/PureUpdate.ico"
                           Width="180" Height="180"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center">
                        <Image.OpacityMask>
                            <RadialGradientBrush>
                                <GradientStop Color="White"       Offset="0.50"/>
                                <GradientStop Color="White"       Offset="0.64"/>
                                <GradientStop Color="#99FFFFFF"   Offset="0.80"/>
                                <GradientStop Color="Transparent" Offset="1.00"/>
                            </RadialGradientBrush>
                        </Image.OpacityMask>
                        <Image.Effect>
                            <DropShadowEffect Color="#0078D4" BlurRadius="52"
                                              ShadowDepth="0" Opacity="0.85"/>
                        </Image.Effect>
                    </Image>
                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center">
                        <Run Text="Pure"   FontSize="24" FontWeight="Light"  Foreground="#8AAEC8"/>
                        <Run Text="Update" FontSize="24" FontWeight="Bold"   Foreground="{DynamicResource ElectricCyanBrush}"/>
                    </TextBlock>
                    <TextBlock Text="Gestionnaire de mises à jour"
                               FontSize="10.5" Foreground="#1E3248"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    <Rectangle Height="1" Margin="20,16,20,0" Opacity="0.5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#1A2E50"     Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>

                <!-- Nav -->
                <StackPanel Grid.Row="1" Margin="0,8,10,8">
                    <RadioButton x:Name="BtnDashboard" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="True" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Tableau de bord" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="BtnLogs" Style="{StaticResource NavButtonStyle}"
                                 Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Historique" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="BtnSettings" Style="{StaticResource NavButtonStyle}"
                                 Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Paramètres" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Version footer -->
                <StackPanel Grid.Row="2" Margin="14,0,14,16">
                    <Rectangle Height="1" Margin="0,0,0,12" Opacity="0.35">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#1A2E50"     Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="v1.3.0  ·  Windows 10/11"
                               FontSize="10.5" Opacity="0.25"
                               HorizontalAlignment="Center" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Frame -->
        <Frame x:Name="MainFrame" Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Background="Transparent"/>
    </Grid>
</Window>
