<Window
    x:Class="PureUpdate.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="PureUpdate — Gestionnaire de mises à jour"
    Width="1380" Height="860"
    MinWidth="1020" MinHeight="660"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource AppBgBrush}">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="BorderBrush"                Value="Transparent"/>
            <Setter Property="Foreground"                 Value="#3A5570"/>
            <Setter Property="FontSize"                   Value="13"/>
            <Setter Property="Padding"                    Value="14,11"/>
            <Setter Property="Margin"                     Value="0,1"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="0,10,10,0" Margin="4,0,8,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ActiveBar" Width="3" HorizontalAlignment="Left"
                                    CornerRadius="0,2,2,0" Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd"        Property="Background" Value="#0F1E38"/>
                                <Setter TargetName="ActiveBar" Property="Background" Value="{DynamicResource ElectricCyanBrush}"/>
                                <Setter Property="Foreground"  Value="{DynamicResource ElectricCyanBrush}"/>
                                <Setter Property="FontWeight"  Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#08FFFFFF"/>
                                <Setter Property="Foreground" Value="#7090B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="9"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Foreground"   Value="#1A2E48"/>
            <Setter Property="Margin"       Value="18,14,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Sidebar ══ -->
        <Border Grid.Column="0" BorderBrush="#0E1C2E" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource AppBgColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource CardBg1Color}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo block -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="16,26,16,10">
                    <Grid>
                        <Image Source="pack://application:,,,/Resources/PureUpdate.ico"
                               Width="160" Height="160" RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center">
                            <Image.OpacityMask>
                                <RadialGradientBrush>
                                    <GradientStop Color="White"       Offset="0.45"/>
                                    <GradientStop Color="White"       Offset="0.62"/>
                                    <GradientStop Color="#88FFFFFF"   Offset="0.80"/>
                                    <GradientStop Color="Transparent" Offset="1.00"/>
                                </RadialGradientBrush>
                            </Image.OpacityMask>
                            <Image.Effect>
                                <DropShadowEffect Color="#0078D4" BlurRadius="60"
                                                  ShadowDepth="0" Opacity="0.7"/>
                            </Image.Effect>
                        </Image>
                    </Grid>
                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center">
                        <Run Text="Pure"   FontSize="22" FontWeight="Light"  Foreground="#6090B0"/>
                        <Run Text="Update" FontSize="22" FontWeight="Bold"   Foreground="{DynamicResource ElectricCyanBrush}"/>
                    </TextBlock>
                    <TextBlock Text="Gestionnaire de mises à jour"
                               FontSize="10" Foreground="#14243A"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <Rectangle Height="1" Margin="24,14,24,0" Opacity="0.4">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#1A3050"     Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="0,6,0,6">
                    <TextBlock Text="PRINCIPAL" Style="{StaticResource NavSectionLabel}"/>
                    <RadioButton x:Name="BtnDashboard" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="True" Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Tableau de bord" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="BtnErrors" Style="{StaticResource NavButtonStyle}"
                                 Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Erreurs" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="BtnUninstall" Style="{StaticResource NavButtonStyle}"
                                 Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Désinstaller" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="BtnDrivers" Style="{StaticResource NavButtonStyle}"
                                 Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B8;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Pilotes" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="OUTILS" Style="{StaticResource NavSectionLabel}"/>
                    <RadioButton x:Name="BtnLogs" Style="{StaticResource NavButtonStyle}"
                                 Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Historique" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="BtnSettings" Style="{StaticResource NavButtonStyle}"
                                 Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Paramètres" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Version footer -->
                <StackPanel Grid.Row="2" Margin="14,0,14,16">
                    <Rectangle Height="1" Margin="0,0,0,10" Opacity="0.3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#1A3050"     Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="v1.5.0  ·  Windows 10/11"
                               FontSize="10" Opacity="0.18"
                               HorizontalAlignment="Center" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Frame -->
        <Frame x:Name="MainFrame" Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Background="Transparent"/>
    </Grid>
</Window>
