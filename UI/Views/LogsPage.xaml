<Page
    x:Class="PureUpdate.UI.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PureUpdate.UI.ViewModels"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="10.5"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#4A6A8A"/>
            <Setter Property="Margin"       Value="0,0,0,6"/>
        </Style>

        <!-- Modern underline TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="14,10" Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <TextBlock x:Name="Txt"
                                       Text="{TemplateBinding Header}"
                                       FontSize="12.5" Foreground="#4A6A90"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd"  Property="BorderBrush" Value="#00B7FF"/>
                                <Setter TargetName="Bd"  Property="Background"  Value="#07004080"/>
                                <Setter TargetName="Txt" Property="Foreground"  Value="#00B7FF"/>
                                <Setter TargetName="Txt" Property="FontWeight"  Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="#08FFFFFF"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="#90C0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- History row template -->
        <DataTemplate x:Key="HistoryRowTemplate">
            <Grid Margin="6,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           FontFamily="Consolas" FontSize="11" Foreground="#2E4A6A"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Date, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Date}" Value="{x:Static system:DateTime.MinValue}">
                                    <Setter Property="Text" Value="—"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1"
                           Text="{Binding Version}" FontFamily="Consolas" FontSize="11"
                           Foreground="#3A5898" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Title}" FontSize="11.5"
                           Foreground="#8CB4D4" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="3" CornerRadius="4" Padding="5,2"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,4,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1AFF4040"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                    <Setter Property="Background" Value="#1A40FF80"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusLabel}" FontSize="9.5" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF6060"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="#50D080"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Package row template -->
        <DataTemplate x:Key="PackageRowTemplate">
            <Grid Margin="6,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title}"
                           FontSize="12" Foreground="#8CB4D4"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Id}"
                           FontFamily="Consolas" FontSize="10.5" Foreground="#2A3E58"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Version}"
                           FontFamily="Consolas" FontSize="10.5" Foreground="#3A5A88"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Historique &amp; Paquets"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="#C8E0F8"/>
            <TextBlock Text="Journal des mises à jour et paquets installés"
                       FontSize="11" Foreground="#4A6A8A" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1"
                    Background="#07101E"
                    BorderBrush="#0E1A2A"
                    Padding="0">

            <!-- ═══ Windows Update History ═══ -->
            <TabItem Header="🪟 Windows Update">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="12,10,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Charger l'historique"
                                       Command="{Binding LoadWuHistoryCommand}"
                                       Appearance="Primary"
                                       Margin="0,0,12,0" Padding="12,6" FontSize="12"/>
                            <TextBlock Text="{Binding WuStatus}"
                                       FontSize="11.5" Foreground="#2E4060"
                                       VerticalAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True" Width="72" Height="3"
                                         Margin="10,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsLoadingWu, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="Exporter HTML"
                                       Command="{Binding ExportHtmlCommand}"
                                       Margin="0,0,6,0" Padding="10,5" FontSize="11"/>
                            <ui:Button Content="Exporter CSV"
                                       Command="{Binding ExportCsvCommand}"
                                       Padding="10,5" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#050A12" Margin="8,0,8,8"
                            CornerRadius="9" BorderBrush="#0E1A2A" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="12,10,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Date"       Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="1" Text="Version"    Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="2" Text="Mise à jour" Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="3" Text="Statut"     Style="{StaticResource ColHeader}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,2">
                                <ItemsControl ItemsSource="{Binding WuHistory}"
                                              ItemTemplate="{StaticResource HistoryRowTemplate}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ Winget packages ═══ -->
            <TabItem Header="📦 Winget">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,6">
                        <ui:Button Content="Charger les paquets"
                                   Command="{Binding LoadPackagesCommand}"
                                   Appearance="Primary"
                                   Margin="0,0,12,0" Padding="12,6" FontSize="12"/>
                        <TextBlock Text="{Binding PkgsStatus}"
                                   FontSize="11.5" Foreground="#2E4060" VerticalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Width="72" Height="3"
                                     Margin="10,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsLoadingPkgs, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#050A12" Margin="8,0,8,8"
                            CornerRadius="9" BorderBrush="#0E1A2A" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="12,10,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nom"     Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="1" Text="ID"      Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="2" Text="Version" Style="{StaticResource ColHeader}"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,2">
                                <ItemsControl ItemsSource="{Binding WingetPackages}"
                                              ItemTemplate="{StaticResource PackageRowTemplate}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ Chocolatey packages ═══ -->
            <TabItem Header="🍫 Chocolatey">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Toolbar (bug fix: load button was missing) -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,6">
                        <ui:Button Content="Charger les paquets"
                                   Command="{Binding LoadPackagesCommand}"
                                   Appearance="Primary"
                                   Margin="0,0,12,0" Padding="12,6" FontSize="12"/>
                        <TextBlock Text="{Binding PkgsStatus}"
                                   FontSize="11.5" Foreground="#2E4060" VerticalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Width="72" Height="3"
                                     Margin="10,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsLoadingPkgs, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#050A12" Margin="8,0,8,8"
                            CornerRadius="9" BorderBrush="#0E1A2A" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="12,10,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nom"     Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="1" Text="ID"      Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="2" Text="Version" Style="{StaticResource ColHeader}"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,2">
                                <ItemsControl ItemsSource="{Binding ChocoPackages}"
                                              ItemTemplate="{StaticResource PackageRowTemplate}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ Scoop packages ═══ -->
            <TabItem Header="🪣 Scoop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Toolbar (bug fix: load button was missing) -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,6">
                        <ui:Button Content="Charger les paquets"
                                   Command="{Binding LoadPackagesCommand}"
                                   Appearance="Primary"
                                   Margin="0,0,12,0" Padding="12,6" FontSize="12"/>
                        <TextBlock Text="{Binding PkgsStatus}"
                                   FontSize="11.5" Foreground="#2E4060" VerticalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Width="72" Height="3"
                                     Margin="10,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsLoadingPkgs, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#050A12" Margin="8,0,8,8"
                            CornerRadius="9" BorderBrush="#0E1A2A" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="12,10,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nom"     Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="1" Text="ID"      Style="{StaticResource ColHeader}"/>
                                <TextBlock Grid.Column="2" Text="Version" Style="{StaticResource ColHeader}"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,2">
                                <ItemsControl ItemsSource="{Binding ScoopPackages}"
                                              ItemTemplate="{StaticResource PackageRowTemplate}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ App activity ═══ -->
            <TabItem Header="📋 Activité app">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,6">
                        <ui:Button Content="Effacer" Command="{Binding ClearAppLogsCommand}"
                                   Margin="0,0,8,0" Padding="10,5" FontSize="12"/>
                        <ui:Button Content="Copier tout" Command="{Binding CopyAllAppLogsCommand}"
                                   Padding="10,5" FontSize="12"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#030710" Margin="8,0,8,8"
                            CornerRadius="9" BorderBrush="#0E1A2A" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <ItemsControl ItemsSource="{Binding AppLogs}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="#3A5878"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LevelText}"
                                                       FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding LevelText, Converter={StaticResource LogLevelBrush}}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Message}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="#5A8AB8" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</Page>
