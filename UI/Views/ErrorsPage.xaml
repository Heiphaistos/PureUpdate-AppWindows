<Page
    x:Class="PureUpdate.UI.Views.ErrorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PureUpdate.UI.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <!-- Convertisseur string hex → SolidColorBrush inline via Style -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="#4A6A8A"/>
            <Setter Property="FontSize"    Value="11.5"/>
            <Setter Property="Padding"     Value="14,6"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="20"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#152540"/>
                                <Setter Property="Foreground" Value="#00B7FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0EFFFFFF"/>
                                <Setter Property="Foreground" Value="#90C0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══ -->
        <Border Grid.Row="0" Padding="28,20,28,16"
                BorderBrush="#131E30" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#07101E" Offset="0"/>
                    <GradientStop Color="#050C18" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="#200810" Margin="0,0,14,0">
                            <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Foreground="#E05050"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#D0E8FF">
                                <Run Text="Erreurs d'installation"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding TotalCount, Mode=OneWay}"
                                     Foreground="#E05050" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Text="Codes d'erreur des mises à jour et paquets échoués"
                                       FontSize="11" Foreground="#3A5A7A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Charger historique"
                               Command="{Binding LoadCommand}"
                               Appearance="Primary"
                               FontSize="12" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Command="{Binding ClearAllCommand}"
                            FontSize="12" Padding="14,8" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"   Value="#1A1010"/>
                                <Setter Property="Foreground"   Value="#8A4040"/>
                                <Setter Property="BorderBrush"  Value="#3A1818"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2A1515"/>
                                                    <Setter Property="Foreground" Value="#C06060"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Vider" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ProgressBar IsIndeterminate="True" Width="50" Height="3" Margin="12,0,0,0"
                                 Foreground="#E05050" VerticalAlignment="Center"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Stat chips ══ -->
        <Border Grid.Row="1" Background="#060C18" Padding="28,12"
                BorderBrush="#0E1A2A" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Border CornerRadius="8" Padding="14,6" Margin="0,0,8,0" Background="#0E1A2E">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#0078D4"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock FontSize="12" Foreground="#7090B0">
                            <Run Text="Windows Update"/>
                            <Run Text=" "/>
                            <Run Text="{Binding WuCount, Mode=OneWay}"
                                 Foreground="#60A0D8" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border CornerRadius="8" Padding="14,6" Margin="0,0,8,0" Background="#0A1624">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#00B7FF"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock FontSize="12" Foreground="#7090B0">
                            <Run Text="Winget"/>
                            <Run Text=" "/>
                            <Run Text="{Binding WingetCount, Mode=OneWay}"
                                 Foreground="#00B7FF" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border CornerRadius="8" Padding="14,6" Margin="0,0,8,0" Background="#1A0E08">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#FF6900"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock FontSize="12" Foreground="#7090B0">
                            <Run Text="Chocolatey"/>
                            <Run Text=" "/>
                            <Run Text="{Binding ChocoCount, Mode=OneWay}"
                                 Foreground="#FF8040" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border CornerRadius="8" Padding="14,6" Margin="0,0,8,0" Background="#091408">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#5CB85C"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock FontSize="12" Foreground="#7090B0">
                            <Run Text="Scoop"/>
                            <Run Text=" "/>
                            <Run Text="{Binding ScoopCount, Mode=OneWay}"
                                 Foreground="#5CB85C" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ══ Filters + Search ══ -->
        <Border Grid.Row="2" Background="#060C18" Padding="28,10"
                BorderBrush="#0E1A2A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource FilterChip}" IsChecked="True"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Tous">
                        <TextBlock Text="Tous"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource FilterChip}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Windows Update">
                        <TextBlock Text="Windows Update"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource FilterChip}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Winget">
                        <TextBlock Text="Winget"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource FilterChip}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Chocolatey">
                        <TextBlock Text="Chocolatey"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource FilterChip}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Scoop">
                        <TextBlock Text="Scoop"/>
                    </RadioButton>
                </StackPanel>

                <!-- Search -->
                <Border Grid.Column="2" CornerRadius="8" Background="#0C1828"
                        BorderBrush="#1A2E48" BorderThickness="1" Height="32" MinWidth="260">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Foreground="#3A5A7A"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#90B0D0" CaretBrush="#90B0D0"
                                 FontSize="11.5" Padding="8,5"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Error cards list ══ -->
        <Grid Grid.Row="3" Background="#060C18">
            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding TotalCount, Converter={StaticResource ZeroToVis}}">
                <Border Width="72" Height="72" CornerRadius="36"
                        Background="#0E1520" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets"
                               FontSize="36" Foreground="#1A2E40"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="13" Foreground="#243040"
                           HorizontalAlignment="Center" Margin="0,16,0,0"
                           TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"/>
            </StackPanel>

            <!-- Cards -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding TotalCount, Converter={StaticResource NonZeroToVis}}">
                <ItemsControl ItemsSource="{Binding FilteredErrors}"
                              Padding="24,12,24,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ErrorDisplayItem}">
                            <Border Margin="0,4" CornerRadius="12" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0A1525" Offset="0"/>
                                        <GradientStop Color="#0C1A2C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#182840" Offset="0"/>
                                        <GradientStop Color="#0E1A28" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Grid>
                                    <!-- Left accent bar colored by provider -->
                                    <Border Width="4" HorizontalAlignment="Left"
                                            CornerRadius="12,0,0,12"
                                            Background="{Binding AccentHex, Converter={StaticResource HexToBrushConv}}"/>

                                    <Grid Margin="20,14,14,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 1: package name + error code badge -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#C8E0FF"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="480"
                                                       VerticalAlignment="Center"/>

                                            <!-- Error code badge (only if non-empty) -->
                                            <Border Margin="12,0,0,0" CornerRadius="6" Padding="10,3"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding ErrorCode, Converter={StaticResource NonEmptyToVis}}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#2A0808" Offset="0"/>
                                                        <GradientStop Color="#1E0C0C" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="#5A1515"/>
                                                </Border.BorderBrush>
                                                <Border.BorderThickness>1</Border.BorderThickness>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10" Foreground="#E05050"
                                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding ErrorCode}"
                                                               FontFamily="Consolas" FontSize="12"
                                                               FontWeight="Bold" Foreground="#FF6060"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Row 2: provider badge + description -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
                                            <Border CornerRadius="4" Padding="7,2" Margin="0,0,10,0"
                                                    Background="#101C2E">
                                                <TextBlock Text="{Binding Provider}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding AccentHex, Converter={StaticResource HexToBrushConv}}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11.5" Foreground="#4A6A8A"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                                        </StackPanel>

                                        <!-- Row 3: date + detail message -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0"
                                                    Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyToVis}}">
                                            <TextBlock Text="{Binding Date, StringFormat='{}{0:dd/MM/yyyy  HH:mm}'}"
                                                       FontFamily="Consolas" FontSize="10"
                                                       Foreground="#253545" VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       FontFamily="Consolas" FontSize="10"
                                                       Foreground="#304050"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="500"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Copy button -->
                                        <Button Grid.Column="1" Grid.RowSpan="3"
                                                Command="{Binding DataContext.CopyErrorCommand,
                                                    RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" Cursor="Hand"
                                                ToolTip="Copier dans le presse-papiers">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background"     Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Opacity"         Value="0.35"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="6" Padding="8,6">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#0EFFFFFF"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="#4A6A90"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ══ Status bar ══ -->
        <Border Grid.Row="4" Background="#050B15" Padding="28,8"
                BorderBrush="#0E1A2A" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="11" Foreground="#2A4060" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Page>
