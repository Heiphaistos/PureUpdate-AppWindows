<Window x:Class="PureUpdate.UI.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mise à jour de PureUpdate" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBgBrush}" Foreground="#C8E0F8" FontFamily="Segoe UI">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" />
        <TextBlock x:Name="VersionText" Foreground="#6C8CB0" Margin="0,4,0,12" />
        <TextBlock Text="Nouveautés :" Margin="0,0,0,4" />
        <Border Background="#091525" BorderBrush="#0E1A28" BorderThickness="1"
                CornerRadius="8" Padding="12" MaxHeight="180">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#6C8CB0" />
        <ProgressBar x:Name="Progress" Height="8" Margin="0,8,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LaterButton" Content="Plus tard" Padding="14,6" Margin="0,0,8,0" Click="OnLater" />
            <Button x:Name="InstallButton" Padding="14,6" Click="OnInstall" />
        </StackPanel>
    </StackPanel>
</Window>
