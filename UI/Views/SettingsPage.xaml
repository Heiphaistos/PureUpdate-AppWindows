<Page
    x:Class="PureUpdate.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    Title="Paramètres">

    <ScrollViewer Margin="24,20,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Text="Paramètres"
                       FontSize="24" FontWeight="SemiBold"
                       Foreground="#E0EEFF" Margin="0,0,0,24"/>

            <!-- Nettoyage système -->
            <ui:Card Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Nettoyage du cache Windows"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="#E0EEFF" Margin="0,0,0,6"/>
                    <TextBlock Text="Supprime le contenu de SoftwareDistribution\Download et les fichiers temporaires système après les mises à jour."
                               FontSize="12" Foreground="#5070A0"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <ui:Button x:Name="BtnCleanCache"
                               Content="Nettoyer le cache"
                               Icon="{ui:SymbolIcon Broom24}"
                               Click="BtnCleanCache_Click"
                               Padding="12,6"
                               FontSize="12"/>
                    <TextBlock x:Name="TxtCleanStatus"
                               Foreground="#4CAF50"
                               FontSize="11"
                               Margin="0,6,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ui:Card>

            <!-- À propos -->
            <ui:Card>
                <StackPanel>
                    <TextBlock Text="À propos de PureUpdate"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="#E0EEFF" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Foreground="#405070" FontSize="12"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="1.0.0" Foreground="#A0C0E0" FontSize="12"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Framework" Foreground="#405070" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text=".NET 8.0 + WPF-UI (Fluent Design)" Foreground="#A0C0E0" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Compatibilité" Foreground="#405070" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Windows 10 / 11 (x64)" Foreground="#A0C0E0" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Licence" Foreground="#405070" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT" Foreground="#A0C0E0" FontSize="12" Margin="0,4,0,0"/>
                    </Grid>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
