<Application
    x:Class="PureUpdate.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:PureUpdate.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
            <conv:UpdateCountConverter x:Key="UpdateCountConv"/>
            <conv:LogLevelToBrushConverter x:Key="LogLevelBrush"/>
            <conv:BoolToBrushConverter x:Key="AdminBrush"
                TrueBrush="#FF4CAF50" FalseBrush="#FFE53935"/>
            <conv:BoolToBrushConverter x:Key="NetworkBrush"
                TrueBrush="#FF4CAF50" FalseBrush="#FFE53935"/>
            <conv:IntNonZeroToVisibilityConverter x:Key="NonZeroToVis"/>
            <conv:IntZeroToVisibilityConverter    x:Key="ZeroToVis"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>
            <conv:HexToBrushConverter x:Key="HexToBrushConv"/>

            <!-- Brand colors -->
            <Color x:Key="AccentBlue">#FF0078D4</Color>
            <Color x:Key="ElectricCyan">#FF00B7FF</Color>
            <SolidColorBrush x:Key="AccentBlueBrush"   Color="{StaticResource AccentBlue}"/>
            <SolidColorBrush x:Key="ElectricCyanBrush" Color="{StaticResource ElectricCyan}"/>

            <!-- Dynamic theme resources (updated by ThemeService) -->
            <Color x:Key="AppBgColor">#FF060C18</Color>
            <Color x:Key="CardBg1Color">#FF091525</Color>
            <Color x:Key="CardBg2Color">#FF0D1C2E</Color>
            <SolidColorBrush x:Key="AppBgBrush" Color="#FF060C18"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
